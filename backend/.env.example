# Copy to backend/.env and fill YOUR OWN values manually.
# The app works without Postgres (JSON fallback). Set DATABASE_URL to enable Postgres.

# --- YOUR Postgres account (assign manually) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Examples:
# Local:      DATABASE_URL=postgresql://postgres:mypassword@localhost:5432/forest_fire
# Neon/Supabase/Render: DATABASE_URL=postgresql://myuser:mypass@db.xxx.neon.tech:5432/forestdb?sslmode=require
DATABASE_URL=

# --- Existing keys (keep yours) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
FIRMS_MAP_KEY=
